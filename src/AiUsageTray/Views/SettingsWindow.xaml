<Window x:Class="AiUsageTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Quota Tray"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="OnWindowLoaded"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- ===== 타이포 ===== -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Margin" Value="2,0,0,7"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ===== 카드 ===== -->

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,4,14,4"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <!-- ===== 스위치 ===== -->

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="21" CornerRadius="10.5"
                                Background="{DynamicResource TrackOffBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="15" Height="15" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1"
                                                      Opacity="0.28" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="17" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 세그먼트 토글 ===== -->

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="6" Background="Transparent"
                                Padding="13,5,13,5" Margin="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 칸이 많을 때 쓰는 좁은 변형 -->
        <Style x:Key="SegmentTight" TargetType="RadioButton"
               BasedOn="{StaticResource Segment}">
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TrackOffBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== 버튼 ===== -->

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 밑줄 없는 조용한 링크 -->
        <Style x:Key="LinkText" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 되돌릴 수 없는 동작. 실수로 누르지 않도록 색으로 경고한다. -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="#E03131">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C92A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 다른 컨트롤과 같은 모서리·색을 쓰는 드롭다운 -->
        <Style x:Key="SoftCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" CornerRadius="5" Margin="3,1"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource TrackOffBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="7"
                                                Background="{DynamicResource TrackOffBrush}"
                                                BorderBrush="Transparent" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 아래를 가리키는 갈매기 -->
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="{DynamicResource SubtleBrush}"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center"
                                                      Margin="8,1,11,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource BorderBrush2}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="Selected"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="11,0,30,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   Placement="Bottom" VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade" Focusable="False">
                                <Border CornerRadius="8" Padding="3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush2}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                                          Direction="270" Opacity="0.24"
                                                          Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 접기/펴기 -->
        <Style x:Key="DisclosureButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8"
                                  Stroke="{DynamicResource SubtleBrush}"
                                  StrokeThickness="1.4" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5" Margin="0,0,7,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                       Foreground="{DynamicResource SubtleBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 스크롤바 =====
             기본 스크롤바는 이 창의 결과 어울리지 않는다. 화살표 단추를 빼고
             막대만 가늘게 남긴다. 내용이 넘칠 때만 보이므로 눈에 띄지 않는다. -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" Padding="2,4,2,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" CornerRadius="2"
                                                        Background="{DynamicResource TrackOffBrush}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background"
                                                                Value="{DynamicResource SubtleBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <!-- 막대 위아래의 빈 곳. 눌러서 한 쪽씩 넘긴다. -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== 본문 ===================== -->

    <Border Background="{DynamicResource WindowBrush}">
        <!--
            내용이 화면보다 길어질 수 있다. SizeToContent="Height"만 두면 창이
            작업 표시줄 밖까지 자라 아래쪽 항목에 손이 닿지 않는다. 창 높이는
            코드에서 화면에 맞게 묶고, 넘치는 만큼만 여기서 굴린다.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel Margin="20,18,20,18">

            <!-- 도구 -->
            <TextBlock x:Name="LblSectionTools" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ClaudeDot" Width="9" Height="9" CornerRadius="4.5"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Claude Code" Style="{StaticResource RowTitle}"/>
                            </StackPanel>
                            <TextBlock x:Name="ClaudeStatus" Style="{StaticResource RowHint}"
                                       Margin="16,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="ClaudeSwatch" Style="{StaticResource Swatch}"
                                    Margin="0,0,10,0" Click="OnPickClaudeColor"/>
                            <CheckBox x:Name="ClaudeEnabled" Style="{StaticResource Switch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="CodexDot" Width="9" Height="9" CornerRadius="4.5"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Codex" Style="{StaticResource RowTitle}"/>
                            </StackPanel>
                            <TextBlock x:Name="CodexStatus" Style="{StaticResource RowHint}"
                                       Margin="16,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="CodexSwatch" Style="{StaticResource Swatch}"
                                    Margin="0,0,10,0" Click="OnPickCodexColor"/>
                            <CheckBox x:Name="CodexEnabled" Style="{StaticResource Switch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- 경로는 평소에 접어둔다. 대부분 자동 탐지로 충분하다. -->
                    <StackPanel Margin="0,9,0,11">
                        <ToggleButton x:Name="PathToggle"
                                      Style="{StaticResource DisclosureButton}"
                                      Checked="OnPathToggle" Unchecked="OnPathToggle"/>

                        <StackPanel x:Name="PathPanel" Visibility="Collapsed" Margin="0,11,0,0">
                            <TextBlock x:Name="LblClaudeCred" FontSize="10.5"
                                       Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClaudePath" Style="{StaticResource PathBox}"
                                         LostFocus="OnPathChanged"/>
                                <Button x:Name="BrowseClaude" Grid.Column="1" 
                                        Style="{StaticResource GhostButton}" Padding="12,6"
                                        Margin="6,0,0,0" Click="OnBrowseClaude"/>
                            </Grid>

                            <TextBlock x:Name="LblCodexFolder" FontSize="10.5"
                                       Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CodexPath" Style="{StaticResource PathBox}"
                                         LostFocus="OnPathChanged"/>
                                <Button x:Name="BrowseCodex" Grid.Column="1" 
                                        Style="{StaticResource GhostButton}" Padding="12,6"
                                        Margin="6,0,0,0" Click="OnBrowseCodex"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- 표시 -->
            <TextBlock x:Name="LblSectionDisplay" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                            <TextBlock x:Name="LblLanguage" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblLanguageHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Width="146"
                                  Style="{StaticResource SoftCombo}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  MaxDropDownHeight="320"
                                  SelectionChanged="OnLanguageChanged"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,190,0">
                            <TextBlock x:Name="LblNumberFormat" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblNumberFormatHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Border Style="{StaticResource SegmentGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeRemaining"
                                             Style="{StaticResource Segment}" GroupName="Mode"
                                             Checked="OnSettingChanged"/>
                                <RadioButton x:Name="ModeUsed"
                                             Style="{StaticResource Segment}" GroupName="Mode"
                                             Checked="OnSettingChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <TextBlock x:Name="LblWidgetBar" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblWidgetBarHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowWidgetBar" Style="{StaticResource Switch}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <TextBlock x:Name="LblPinTaskbar" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="TaskbarHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="PinToTaskbar" Style="{StaticResource Switch}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- 동작 -->
            <TextBlock x:Name="LblSectionBehavior" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <StackPanel Margin="0,11,0,11">
                        <TextBlock x:Name="LblInterval" Style="{StaticResource RowTitle}"/>
                        <TextBlock x:Name="LblIntervalHint" Style="{StaticResource RowHint}"/>
                        <Border Style="{StaticResource SegmentGroup}"
                                HorizontalAlignment="Stretch" Margin="0,9,0,0">
                            <UniformGrid x:Name="IntervalGroup" Rows="1"/>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,10,0,10">
                        <TextBlock x:Name="LblStartup" Style="{StaticResource RowTitle}"/>
                        <CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <TextBlock x:Name="LblWindowPrimer" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblWindowPrimerHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="WindowPrimerEnabled" Style="{StaticResource Switch}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- 시스템 -->
            <TextBlock x:Name="LblSectionSystem" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <!-- 현재 버전 · 업데이트 확인 · 자동 업데이트 -->
                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblVersion" Style="{StaticResource RowTitle}"/>
                                <!-- 새 버전이 있을 때만 보이는 점 -->
                                <Border x:Name="UpdateDot" Width="6" Height="6" CornerRadius="3"
                                        Background="#3FB950" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="VersionText" Style="{StaticResource RowHint}"/>
                                <TextBlock x:Name="UpdateText" Style="{StaticResource RowHint}"
                                           Margin="6,2,0,0"/>
                                <!-- 내려받는 동안에만 보이는 진행 막대 -->
                                <Border x:Name="UpdateProgressTrack" Width="90" Height="4"
                                        CornerRadius="2" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        Background="{DynamicResource TrackOffBrush}">
                                    <Border x:Name="UpdateProgressFill" Width="0" Height="4"
                                            CornerRadius="2" HorizontalAlignment="Left"
                                            Background="#3FB950"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="UpdateButton" Grid.Column="1"
                                Style="{StaticResource GhostButton}" Padding="12,6"
                                VerticalAlignment="Center" Margin="0,0,14,0"
                                Click="OnUpdateClick"/>

                        <!-- 토글만 있으면 무엇을 켜고 끄는지 알 수 없다. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="LblAutoUpdate" Style="{StaticResource RowHint}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox x:Name="AutoUpdateEnabled"
                                      Style="{StaticResource Switch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- 설치 위치. 어디에 깔렸는지 보이지 않으면 지웠는지도 모른다. -->
                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblInstallPath" Style="{StaticResource RowTitle}"/>
                                <Border x:Name="LauncherDot" Width="6" Height="6" CornerRadius="3"
                                        Margin="8,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LauncherStatus" Style="{StaticResource RowHint}"
                                           Margin="0,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 경로는 길다. 창을 넓히지 않도록 끝을 줄인다. -->
                            <TextBlock x:Name="InstallPathText" Style="{StaticResource RowHint}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="OpenFolderButton" Style="{StaticResource GhostButton}"
                                Padding="12,6" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnOpenInstallFolder"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- 설정 초기화 -->
                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                            <TextBlock x:Name="LblResetAll" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblResetAllHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button x:Name="ResetAllButton" Style="{StaticResource DangerButton}"
                                Padding="12,6" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnResetAll"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- 문제 및 버그 신고 -->
                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                            <TextBlock x:Name="LblIssues" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblIssuesHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button x:Name="IssuesLink" Style="{StaticResource GhostButton}"
                                Padding="12,6" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnOpenIssues"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- 연결 시험. 값이 안 보일 때 어디가 막혔는지 짚어 준다. -->
                    <Grid Margin="0,10,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                            <TextBlock x:Name="LblTest" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblTestHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button x:Name="TestButton" Style="{StaticResource GhostButton}"
                                Padding="12,6" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnTest"/>
                    </Grid>

                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
