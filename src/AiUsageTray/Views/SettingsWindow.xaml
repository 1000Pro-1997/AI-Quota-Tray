<Window x:Class="AiUsageTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Quota Tray"
        Width="480" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="OnWindowLoaded"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- ===== 타이포 ===== -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ===== 카드 ===== -->

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,3,14,3"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <!-- ===== 스위치 ===== -->

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="21" CornerRadius="10.5"
                                Background="{DynamicResource TrackOffBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="15" Height="15" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1"
                                                      Opacity="0.28" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="17" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 모델 아래에 붙는 자동 요청은 보조 설정이므로 본 토글보다 작게 보인다. -->
        <Style x:Key="CompactSwitch" TargetType="CheckBox"
               BasedOn="{StaticResource Switch}">
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.78" ScaleY="0.78"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChildSettings" TargetType="Border">
            <Setter Property="Margin" Value="17,1,0,9"/>
            <Setter Property="Padding" Value="10,4,8,4"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Background" Value="{DynamicResource TrackOffBrush}"/>
            <Setter Property="CornerRadius" Value="0,5,5,0"/>
        </Style>

        <Style x:Key="ChildSettingText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- ===== 세그먼트 토글 ===== -->

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="6" Background="Transparent"
                                Padding="13,5,13,5" Margin="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 칸이 많을 때 쓰는 좁은 변형 -->
        <Style x:Key="SegmentTight" TargetType="RadioButton"
               BasedOn="{StaticResource Segment}">
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TrackOffBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== 버튼 ===== -->

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 진행률이 차오르는 버튼 =====
             내려받는 동안 따로 막대를 두면 좁은 줄이 더 복잡해진다. 버튼 자체가
             왼쪽부터 파랗게 차오르고 글씨가 퍼센트를 알린다.

             채움 너비는 코드에서 Tag(0~1)를 주면 변환기가 실제 픽셀로 바꾼다.
             ControlTemplate 안에서는 ActualWidth에 곱셈을 걸 수 없다. -->
        <Style x:Key="ProgressButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" ClipToBounds="True"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                            <Grid>
                                <!-- 차오르는 부분. 진행이 없으면 너비가 0이라 안 보인다. -->
                                <Border x:Name="Fill" HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="-12,-6,-12,-6"
                                        Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverStrongBrush}"/>
                            </Trigger>
                            <!-- 내려받는 중에는 눌러도 소용없어 흐리게 하지만,
                                 퍼센트는 읽혀야 하므로 많이 흐리게 하지 않는다. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 밑줄 없는 조용한 링크 -->
        <Style x:Key="LinkText" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 되돌릴 수 없는 동작. 실수로 누르지 않도록 색으로 경고한다. -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="#E03131">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C92A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 다른 컨트롤과 같은 모서리·색을 쓰는 드롭다운 -->
        <Style x:Key="SoftCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" CornerRadius="5" Margin="3,1"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource TrackOffBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="7"
                                                Background="{DynamicResource TrackOffBrush}"
                                                BorderBrush="Transparent" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 아래를 가리키는 갈매기 -->
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="{DynamicResource SubtleBrush}"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center"
                                                      Margin="8,1,11,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource BorderBrush2}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="Selected"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="11,0,30,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   Placement="Bottom" VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade" Focusable="False">
                                <Border CornerRadius="8" Padding="3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush2}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                                          Direction="270" Opacity="0.24"
                                                          Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactNumberBox" TargetType="TextBox"
               BasedOn="{StaticResource PathBox}">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource TrackOffBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
                    <Setter Property="Opacity" Value="0.72"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 접기/펴기 -->
        <Style x:Key="DisclosureButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8"
                                  Stroke="{DynamicResource SubtleBrush}"
                                  StrokeThickness="1.4" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5" Margin="0,0,7,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                       Foreground="{DynamicResource SubtleBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 스크롤바 =====
             iOS처럼 내용 위에 얹혀 뜬다. 자리를 차지하지 않으니 본문 폭이
             스크롤 유무에 따라 흔들리지 않는다.

             평소에는 반쯤 비치다 손을 올리면 진해지고 굵어진다. 화살표 단추는
             두지 않는다. 눌러 본 사람이 없다. -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border x:Name="Root" Background="Transparent" Padding="0,5,3,5">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb x:Name="Grip">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- 실제로 잡히는 넓이는 그대로 두고
                                                     보이는 막대만 가늘게 그린다. 얇은
                                                     막대는 손으로 집기 어렵다. -->
                                                <Border Background="Transparent">
                                                    <Border x:Name="Bar" Width="5"
                                                            HorizontalAlignment="Right"
                                                            CornerRadius="2.5"
                                                            Background="{DynamicResource SubtleBrush}"
                                                            Opacity="0.4"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- 손을 올리면 진해지고 굵어진다.
                                                         오른쪽에 붙여 두어 굵어져도
                                                         가장자리 자리는 그대로다. -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Opacity"
                                                                Value="0.75"/>
                                                        <Setter TargetName="Bar" Property="Width"
                                                                Value="8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bar" Property="Opacity"
                                                                Value="0.9"/>
                                                        <Setter TargetName="Bar" Property="Width"
                                                                Value="8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <!-- 막대 위아래의 빈 곳. 눌러서 한 쪽씩 넘긴다. -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== 본문 ===================== -->

    <Border Background="{DynamicResource WindowBrush}">
        <!--
            내용이 화면보다 길어질 수 있다. SizeToContent="Height"만 두면 창이
            작업 표시줄 밖까지 자라 아래쪽 항목에 손이 닿지 않는다. 창 높이는
            코드에서 화면에 맞게 묶고, 넘치는 만큼만 여기서 굴린다.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
            </ScrollViewer.Resources>
            <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer">
                    <!-- 막대를 본문과 같은 칸에 겹쳐 놓는다. 기본 템플릿처럼 칸을
                         나누면 스크롤이 생기는 순간 본문이 그만큼 밀려 글이 다시
                         배치된다. Grid.ZIndex를 주어 막대가 위에 오게 한다.

                         이름을 PART_VerticalScrollBar로 두면 ScrollViewer가 값과
                         움직임을 알아서 이어 준다. 바인딩을 직접 걸면 한쪽으로만
                         흘러 막대를 끌어도 내용이 따라오지 않는다. -->
                    <Grid>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Margin="{TemplateBinding Padding}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Panel.ZIndex="1"
                                   Orientation="Vertical"
                                   HorizontalAlignment="Right"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay,
                                           RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </ScrollViewer.Template>
            <StackPanel Margin="20,13,22,13">

            <!-- 도구 -->
            <TextBlock x:Name="LblSectionTools" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ClaudeDot" Width="9" Height="9" CornerRadius="4.5"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Claude Code" Style="{StaticResource RowTitle}"/>
                            </StackPanel>
                            <TextBlock x:Name="ClaudeStatus" Style="{StaticResource RowHint}"
                                       Margin="16,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="ClaudeDetailsToggle"
                                          Style="{StaticResource DisclosureButton}"
                                          Margin="0,0,12,0"
                                          Checked="OnDetailsToggle" Unchecked="OnDetailsToggle"/>
                            <Button x:Name="ClaudeSwatch" Style="{StaticResource Swatch}"
                                    Margin="0,0,10,0" Click="OnPickClaudeColor"/>
                            <CheckBox x:Name="ClaudeEnabled" Style="{StaticResource Switch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ClaudeDetailsPanel" Style="{StaticResource ChildSettings}"
                            Visibility="Collapsed">
                      <StackPanel>
                        <Grid Height="25">
                            <TextBlock x:Name="LblClaudePrimeFive" Style="{StaticResource ChildSettingText}"
                                       Margin="0,0,42,0"/>
                            <CheckBox x:Name="ClaudePrimeFive" Style="{StaticResource CompactSwitch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </Grid>
                        <Grid Height="25">
                            <TextBlock x:Name="LblClaudePrimeWeekly" Style="{StaticResource ChildSettingText}"
                                       Margin="0,0,42,0"/>
                            <CheckBox x:Name="ClaudePrimeWeekly" Style="{StaticResource CompactSwitch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" Margin="0,3,0,7"/>
                        <TextBlock x:Name="LblClaudeCred" Style="{StaticResource ChildSettingText}"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ClaudePath" Style="{StaticResource PathBox}"
                                     FontSize="10.5" LostFocus="OnPathChanged"/>
                            <Button x:Name="BrowseClaude" Grid.Column="1"
                                    Style="{StaticResource GhostButton}" Padding="10,5"
                                    Margin="6,0,0,0" Click="OnBrowseClaude"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="CodexDot" Width="9" Height="9" CornerRadius="4.5"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Codex" Style="{StaticResource RowTitle}"/>
                            </StackPanel>
                            <TextBlock x:Name="CodexStatus" Style="{StaticResource RowHint}"
                                       Margin="16,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="CodexDetailsToggle"
                                          Style="{StaticResource DisclosureButton}"
                                          Margin="0,0,12,0"
                                          Checked="OnDetailsToggle" Unchecked="OnDetailsToggle"/>
                            <Button x:Name="CodexSwatch" Style="{StaticResource Swatch}"
                                    Margin="0,0,10,0" Click="OnPickCodexColor"/>
                            <CheckBox x:Name="CodexEnabled" Style="{StaticResource Switch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="CodexDetailsPanel" Style="{StaticResource ChildSettings}"
                            Visibility="Collapsed">
                      <StackPanel>
                        <Grid Height="25">
                            <TextBlock x:Name="LblCodexPrimeFive" Style="{StaticResource ChildSettingText}"
                                       Margin="0,0,42,0"/>
                            <CheckBox x:Name="CodexPrimeFive" Style="{StaticResource CompactSwitch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </Grid>
                        <Grid Height="25">
                            <TextBlock x:Name="LblCodexPrimeWeekly" Style="{StaticResource ChildSettingText}"
                                       Margin="0,0,42,0"/>
                            <CheckBox x:Name="CodexPrimeWeekly" Style="{StaticResource CompactSwitch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" Margin="0,3,0,7"/>
                        <TextBlock x:Name="LblCodexFolder" Style="{StaticResource ChildSettingText}"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CodexPath" Style="{StaticResource PathBox}"
                                     FontSize="10.5" LostFocus="OnPathChanged"/>
                            <Button x:Name="BrowseCodex" Grid.Column="1"
                                    Style="{StaticResource GhostButton}" Padding="10,5"
                                    Margin="6,0,0,0" Click="OnBrowseCodex"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- 표시 -->
            <TextBlock x:Name="LblSectionDisplay" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                            <TextBlock x:Name="LblLanguage" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblLanguageHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Width="146"
                                  Style="{StaticResource SoftCombo}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  MaxDropDownHeight="320"
                                  SelectionChanged="OnLanguageChanged"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,190,0">
                            <TextBlock x:Name="LblNumberFormat" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblNumberFormatHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Border Style="{StaticResource SegmentGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeRemaining"
                                             Style="{StaticResource Segment}" GroupName="Mode"
                                             Checked="OnSettingChanged"/>
                                <RadioButton x:Name="ModeUsed"
                                             Style="{StaticResource Segment}" GroupName="Mode"
                                             Checked="OnSettingChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <TextBlock x:Name="LblPinTaskbar" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="TaskbarHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="PinToTaskbar" Style="{StaticResource Switch}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- 위젯 -->
            <TextBlock x:Name="LblSectionWidget" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <TextBlock x:Name="LblWidgetBar" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblWidgetBarHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowWidgetBar" Style="{StaticResource Switch}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>
                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <TextBlock x:Name="LblWidgetAutoSize" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblWidgetAutoSizeHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="WidgetSizeInputs" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock x:Name="LblWidgetWidth" Style="{StaticResource RowHint}"
                                               Width="28" VerticalAlignment="Center"/>
                                    <TextBox x:Name="WidgetWidth" Style="{StaticResource CompactNumberBox}"
                                             TextAlignment="Right" TextChanged="OnWidgetSizeTextChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblWidgetHeight" Style="{StaticResource RowHint}"
                                               Width="28" VerticalAlignment="Center"/>
                                    <TextBox x:Name="WidgetHeight" Style="{StaticResource CompactNumberBox}"
                                             TextAlignment="Right" TextChanged="OnWidgetSizeTextChanged"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox x:Name="WidgetAutoSize" Style="{StaticResource Switch}"
                                      Checked="OnAutoSizeToggled" Unchecked="OnAutoSizeToggled"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>
                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <TextBlock x:Name="LblWidgetOrientation" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblWidgetOrientationHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="WidgetModelsHorizontal" Style="{StaticResource Switch}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <Border x:Name="WidgetMonitorDivider" Style="{StaticResource RowDivider}"/>
                    <Grid x:Name="WidgetMonitorRow" Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,190,0">
                            <TextBlock x:Name="LblWidgetMonitor" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblWidgetMonitorHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <ComboBox x:Name="WidgetMonitorBox" Width="176" Style="{StaticResource SoftCombo}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  SelectionChanged="OnWidgetMonitorChanged"/>
                    </Grid>

                    <Border x:Name="WidgetAutoOffsetDivider" Style="{StaticResource RowDivider}"/>
                    <Grid x:Name="WidgetAutoOffsetRow" Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <TextBlock x:Name="LblWidgetAutoOffset" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblWidgetAutoOffsetHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <StackPanel x:Name="WidgetOffsetRow" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock x:Name="LblWidgetOffsetX" Style="{StaticResource RowHint}"
                                               Width="28" VerticalAlignment="Center"/>
                                    <TextBox x:Name="WidgetOffsetX" Style="{StaticResource CompactNumberBox}"
                                             TextAlignment="Right" TextChanged="OnOffsetTextChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblWidgetOffsetY" Style="{StaticResource RowHint}"
                                               Width="28" VerticalAlignment="Center"/>
                                    <TextBox x:Name="WidgetOffsetY" Style="{StaticResource CompactNumberBox}"
                                             TextAlignment="Right" TextChanged="OnOffsetTextChanged"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox x:Name="WidgetAutoOffset" Style="{StaticResource Switch}"
                                      Checked="OnAutoOffsetToggled" Unchecked="OnAutoOffsetToggled"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 동작 -->
            <TextBlock x:Name="LblSectionBehavior" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <StackPanel Margin="0,11,0,11">
                        <TextBlock x:Name="LblInterval" Style="{StaticResource RowTitle}"/>
                        <TextBlock x:Name="LblIntervalHint" Style="{StaticResource RowHint}"/>
                        <Border Style="{StaticResource SegmentGroup}"
                                HorizontalAlignment="Stretch" Margin="0,9,0,0">
                            <UniformGrid x:Name="IntervalGroup" Rows="1"/>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource RowDivider}"/>

                    <Grid Margin="0,7,0,7">
                        <TextBlock x:Name="LblStartup" Style="{StaticResource RowTitle}"/>
                        <CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- 시스템 -->
            <TextBlock x:Name="LblSectionSystem" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <!-- 현재 버전 · 업데이트 확인 · 자동 업데이트 -->
                    <Grid Margin="0,7,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblVersion" Style="{StaticResource RowTitle}"/>
                                <!-- 새 버전이 있을 때만 보이는 점 -->
                                <Border x:Name="UpdateDot" Width="6" Height="6" CornerRadius="3"
                                        Background="#3FB950" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                            <!-- 상태는 버튼이 말한다. 여기는 번호만 둔다. -->
                            <TextBlock x:Name="VersionText" Style="{StaticResource RowHint}"/>
                        </StackPanel>

                        <!-- 확인·내려받기·재시작을 이 버튼 하나가 다 한다.
                             내려받는 동안에는 스스로 파랗게 차오르며 퍼센트를 쓴다. -->
                        <Button x:Name="UpdateButton" Grid.Column="1"
                                Style="{StaticResource ProgressButton}" Padding="12,6"
                                MinWidth="104"
                                VerticalAlignment="Center" Margin="0,0,14,0"
                                Click="OnUpdateClick"/>

                        <!-- 토글만 있으면 무엇을 켜고 끄는지 알 수 없다. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="LblAutoUpdate" Style="{StaticResource RowHint}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox x:Name="AutoUpdateEnabled"
                                      Style="{StaticResource Switch}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- 설치 위치. 어디에 깔렸는지 보이지 않으면 지웠는지도 모른다. -->
                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblInstallPath" Style="{StaticResource RowTitle}"/>
                                <Border x:Name="LauncherDot" Width="6" Height="6" CornerRadius="3"
                                        Margin="8,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LauncherStatus" Style="{StaticResource RowHint}"
                                           Margin="0,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 경로는 길다. 창을 넓히지 않도록 끝을 줄인다. -->
                            <TextBlock x:Name="InstallPathText" Style="{StaticResource RowHint}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <!-- 런처가 사라졌을 때만 나타난다. 앱만 내려받아 쓰는 사람에게
                                 지금 바로 고칠 수단을 주려는 것이다. -->
                            <Button x:Name="InstallLauncherButton" Style="{StaticResource GhostButton}"
                                    Padding="12,6" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    Click="OnInstallLauncher"/>
                            <Button x:Name="OpenFolderButton" Style="{StaticResource GhostButton}"
                                    Padding="12,6"
                                    VerticalAlignment="Center" Click="OnOpenInstallFolder"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- 설정 초기화 -->
                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                            <TextBlock x:Name="LblResetAll" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblResetAllHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button x:Name="ResetAllButton" Style="{StaticResource DangerButton}"
                                Padding="12,6" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnResetAll"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- 프로젝트 홈페이지 -->
                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                            <TextBlock x:Name="LblGitHub" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblGitHubHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button x:Name="GitHubLink" Style="{StaticResource GhostButton}"
                                Padding="12,6" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnOpenGitHub"/>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- 문제 및 버그 신고 -->
                    <Grid Margin="0,7,0,7">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                            <TextBlock x:Name="LblIssues" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="LblIssuesHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button x:Name="IssuesLink" Style="{StaticResource GhostButton}"
                                Padding="12,6" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="OnOpenIssues"/>
                    </Grid>

                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
