<Window x:Class="AiUsageTray.Views.WidgetBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Quota Tray Widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        Focusable="False" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 도구별 색 블록이 가로로 늘어선다. 각 블록 안에 한도별 줄이 쌓인다. -->
    <!-- Grid로 두어야 블록들이 같은 높이로 늘어난다. 열은 코드에서 추가한다. -->
    <!-- Background가 없으면 히트 테스트가 안 되어 클릭이 그대로 통과한다.
         투명이라도 값이 있어야 마우스를 받는다. -->
    <Grid x:Name="Items" Cursor="Hand" Background="Transparent"/>
</Window>
